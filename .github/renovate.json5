{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
  ],
  enabledManagers: [
    'github-actions',
  ],
  packageRules: [
    {
      matchManagers: [
        'github-actions',
      ],
      labels: [
        'CICD',
        'ignore-for-release',
      ],
    },
  ],
}
